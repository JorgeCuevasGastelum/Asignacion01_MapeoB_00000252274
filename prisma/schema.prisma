generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EstadoReservacion {
  confirmada
  cancelada
  completada
}

model Cliente {
  id            Int           @id @default(autoincrement())
  nombre        String        @db.VarChar(100)
  telefono      String        @db.VarChar(20)
  correo        String        @unique @db.VarChar(191)
  reservaciones Reservacion[]
}

model Mesa {
  id            Int           @id @default(autoincrement())
  numero        Int           @unique
  capacidad     Int
  reservaciones Reservacion[]
}

model Turno {
  id            Int           @id @default(autoincrement())
  nombre        String        @db.VarChar(60)
  horaInicio    DateTime      @db.Time(0)
  horaFin       DateTime      @db.Time(0)
  reservaciones Reservacion[]
}

model Reservacion {
  id        Int               @id @default(autoincrement())
  fecha     DateTime          @db.Date
  estado    EstadoReservacion @default(confirmada)
  clienteId Int
  mesaId    Int
  turnoId   Int
  cliente   Cliente           @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mesa      Mesa              @relation(fields: [mesaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  turno     Turno             @relation(fields: [turnoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([mesaId, turnoId])
}
